# ── Discord Bot ────────────────────────────────────────────────────────────────
# Required for the bot to authenticate with Discord
DISCORD_TOKEN=your_bot_token_here

# Your Discord Application's Client ID (from Discord Developer Portal)
DISCORD_CLIENT_ID=your_client_id_here

# Optional: restrict slash command registration to one guild during development
# Leave blank for global registration (takes up to 1 hour to propagate)
DISCORD_GUILD_ID=

# ── Web Server ─────────────────────────────────────────────────────────────────
# Port for Express server (default: 3000)
PORT=3000

# ── Database ───────────────────────────────────────────────────────────────────
# Path to SQLite database file (relative to clock/ directory)
DB_PATH=./data/timezones.db

# ── CORS (development only) ────────────────────────────────────────────────────
# Set to your frontend origin when running web and bot on separate ports
# Leave blank in production (Express serves the frontend directly)
CORS_ORIGIN=

# ── Optional ───────────────────────────────────────────────────────────────────
# Log level: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info
